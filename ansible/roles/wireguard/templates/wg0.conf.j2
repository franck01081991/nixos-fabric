[Interface]
PrivateKey = {{ lookup('file', '/etc/wireguard/' + inventory_hostname + '.key') }}
Address = {{ wireguard_address | default('10.255.0.1/24') }}
ListenPort = {{ wireguard_port | default(51820) }}

{% for peer in wireguard_peers %}
[Peer]
PublicKey = {{ peer.public_key }}
AllowedIPs = {{ peer.allowed_ips | join(', ') }}
{% if peer.endpoint is defined %}
Endpoint = {{ peer.endpoint }}:{{ wireguard_port | default(51820) }}
PersistentKeepalive = {{ peer.persistent_keepalive | default(25) }}
{% endif %}
{% endfor %}
