{ config, lib, pkgs, ... }:

{
  services.frr = {
    enable = true;
    bgpd.enable = true;
    ospfd.enable = true;

    config = lib.concatStringsSep "\n" [
      ''
      frr defaults traditional
      hostname {{ inventory_hostname }}
      service integrated-vtysh-config
      log syslog informational
      ''

      ''
      router bgp {{ bgp_as }}
        bgp router-id {{ bgp_router_id }}
        {% if bgp_cluster_id is defined %}
        bgp cluster-id {{ bgp_cluster_id }}
        {% endif %}

        {% for neighbor in bgp_neighbors %}
        neighbor {{ neighbor.ip }} remote-as {{ neighbor.as }}
        neighbor {{ neighbor.ip }} update-source lo
        neighbor {{ neighbor.ip }} ebgp-multihop {{ neighbor.ebgp_multihop | default(5) }}
        {% endfor %}

        address-family ipv4 unicast
          {% for network in bgp_networks %}
          network {{ network }}
          {% endfor %}
          {% for neighbor in bgp_neighbors %}
          neighbor {{ neighbor.ip }} activate
          {% endfor %}
        exit-address-family

        {% if bgp_evpn_enabled | default(false) %}
        address-family l2vpn evpn
          {% for neighbor in bgp_neighbors %}
          neighbor {{ neighbor.ip }} activate
          {% endfor %}
        exit-address-family
        {% endif %}
      !
      ''

      ''
      router ospf
        ospf router-id {{ ospf_router_id }}
        {% for network in ospf_networks %}
        network {{ network }} area {{ ospf_area | default(0) }}
        {% endfor %}
        passive-interface default
        {% for interface in ospf_passive_interfaces | default([]) %}
        passive-interface {{ interface }}
        {% endfor %}
      !
      ''
    ];
  };
}
